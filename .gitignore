# --- secrets: never commit these ---
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# --- generated / derived artifacts ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Story OS run artifacts: regenerable, sometimes large
projects/*/runs/
projects/*/.cache/
*.log

# --- OS noise ---
.DS_Store
Thumbs.db
storyos-backup.bundle

# Build metadata. Regenerated by `pip install -e .` on every install, so
# tracking it produces a dirty tree after any environment rebuild.
*.egg-info/
build/
dist/
