# Story OS secrets. Copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env
#
# .env is gitignored. Do not paste these values into Google Docs, Notion pages,
# chat messages, commit messages, or issue trackers. If a key has ever been
# stored in plaintext somewhere shared, rotate it rather than moving it.

# --- Anthropic (default provider) ---
# Create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- OpenAI-compatible endpoints (optional, pick what you use) ---
# z.ai / Zhipu, for GLM-5.2. https://z.ai
ZAI_API_KEY=

# OpenRouter, if you'd rather route everything through one bill.
OPENROUTER_API_KEY=

# Local Ollama needs no key, but the client wants a non-empty string.
OLLAMA_API_KEY=ollama

# --- Notion mirror (optional; only if you sync chapter status to a board) ---
# Create at https://www.notion.so/my-integrations
NOTION_API_KEY=
NOTION_DATABASE_ID=
